# ix1 — Fedora-based desktop operating system (bootc image)
# Milestones: M1 OS foundation, M2 boot, M4 desktop shell.
#
# Build:  ./scripts/build-image.sh
# Boot:   see tests/boot/ and scripts/boot-qemu.sh

# ---- ix1-shell build stage --------------------------------------------------
FROM quay.io/fedora/fedora-bootc:44 AS shell-build

RUN dnf -y install \
        gcc-c++ cmake make \
        qt6-qtbase-devel qt6-qtdeclarative-devel qt6-qtwayland-devel \
        layer-shell-qt kf6-kidletime-devel pam-devel \
    && dnf clean all

COPY desktop/ix1-shell /src/ix1-shell
COPY desktop/ix1-settings /src/ix1-settings
COPY desktop/ix1-software-center /src/ix1-software-center
RUN cmake -S /src/ix1-shell -B /build-shell \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
    && cmake --build /build-shell -j"$(nproc)" \
    && cmake --install /build-shell \
    && cmake -S /src/ix1-settings -B /build-settings \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
    && cmake --build /build-settings -j"$(nproc)" \
    && cmake --install /build-settings \
    && cmake -S /src/ix1-software-center -B /build-software-center \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
    && cmake --build /build-software-center -j"$(nproc)" \
    && cmake --install /build-software-center

# ---- Final image ------------------------------------------------------------
FROM quay.io/fedora/fedora-bootc:44

ARG IX1_RELEASE=dev

# ---- Product identity -------------------------------------------------------
RUN echo "ix1" > /etc/hostname && \
    sed -i 's/^#?\s*SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config && \
    sed -i 's/^#?\s*SELINUXTYPE=.*/SELINUXTYPE=targeted/' /etc/selinux/config

# ---- Core system packages ---------------------------------------------------
# Kernel, firmware, and boot plumbing come from the base image.
# Install the userland required for a functional desktop foundation.
RUN dnf -y install \
        NetworkManager \
        network-manager-applet \
        bluez \
        pipewire pipewire-pulse wireplumber \
        mesa-dri-drivers mesa-vulkan-drivers mesa-va-drivers \
        xorg-x11-drv-amdgpu xorg-x11-drv-ati xorg-x11-drv-intel xorg-x11-drv-nouveau \
        xorg-x11-drv-qxl \
        flatpak xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-kde \
        selinux-policy selinux-policy-targeted \
        openssh-clients openssh-server \
        htop btop lsof tree vim-enhanced tmux psmisc \
        fontconfig google-noto-sans-fonts google-noto-serif-fonts \
        rsms-inter-fonts adwaita-icon-theme \
        xterm \
        xdg-utils dbus-x11 polkit \
        gnome-keyring libsecret \
        qrencode \
        && dnf clean all

# ---- Desktop environment (M4) ------------------------------------------------
# KWin Wayland compositor, Qt6/QML stack, shell placement, display manager.
RUN dnf -y install \
        kwin layer-shell-qt \
        qt6-qtdeclarative qt6-qtwayland qt6-qtsvg qt6-qt5compat \
        kf6-kidletime \
        sddm \
        && dnf clean all

# ---- M5 essential applications ------------------------------------------------
RUN dnf -y install \
        konsole dolphin kate plasma-systemmonitor firefox \
        && dnf clean all

# Keep kernel packages under kernel-install control (matches Fedora bootc guidance).
RUN dnf -y install kernel && dnf clean all

# ---- ix1 session ------------------------------------------------------------
COPY distribution/bootc/files/usr/share/wayland-sessions/ix1.desktop \
     /usr/share/wayland-sessions/ix1.desktop
COPY distribution/bootc/files/usr/bin/ix1-session /usr/bin/ix1-session
RUN chmod 755 /usr/bin/ix1-session

# systemd user unit: ix1-session.target (BindsTo=graphical-session.target)
# so xdg-desktop-portal and backends start for Flatpak permission prompts.
COPY distribution/bootc/files/usr/lib/systemd/user/ix1-session.target \
     /usr/lib/systemd/user/ix1-session.target

# Create the ix1 user's home directory on first boot (Anaconda's bootc
# kickstart payload does not create it).
COPY distribution/bootc/files/usr/lib/tmpfiles.d/ix1-home.conf \
     /usr/lib/tmpfiles.d/ix1-home.conf

# Display manager defaults to the ix1 session.
RUN mkdir -p /etc/sddm.conf.d && \
    printf '[General]\nDefaultSession=ix1\n' > /etc/sddm.conf.d/00-ix1.conf

# Desktop OS default target (Anaconda may override at install time).
RUN systemctl set-default graphical.target || true

# Shell and settings binaries built in the build stage.
COPY --from=shell-build /usr/bin/ix1-shell /usr/bin/ix1-shell
COPY --from=shell-build /usr/bin/ix1-settings /usr/bin/ix1-settings
COPY --from=shell-build /usr/bin/ix1-software-center /usr/bin/ix1-software-center
RUN chmod 755 /usr/bin/ix1-shell /usr/bin/ix1-settings /usr/bin/ix1-software-center

COPY distribution/bootc/files/usr/share/applications/ix1-settings.desktop \
     /usr/share/applications/ix1-settings.desktop
COPY distribution/bootc/files/usr/share/applications/ix1-software-center.desktop \
     /usr/share/applications/ix1-software-center.desktop

# ---- M7: signed updates and recovery ----------------------------------------
# Containers policy: pulls of the ix1 image from the update registry must
# carry a valid ix1 sigstore signature (verified against the baked-in public
# key). Applies to the Anaconda install pull and to `bootc upgrade`.
COPY distribution/bootc/files/etc/containers/policy.json \
     /etc/containers/policy.json
COPY distribution/bootc/files/etc/pki/containers/ix1.pub \
     /etc/pki/containers/ix1.pub
# Dev registry (plain HTTP on the QEMU host); a production registry uses TLS.
COPY distribution/bootc/files/etc/containers/registries.conf.d/ix1-dev-registry.conf \
     /etc/containers/registries.conf.d/ix1-dev-registry.conf
# Signatures live as <digest>.sig attachments in the registry itself.
COPY distribution/bootc/files/etc/containers/registries.d/ix1-sigstore.yaml \
     /etc/containers/registries.d/ix1-sigstore.yaml
# Privileged update helper for ix1-settings (pkexec, wheel-only).
COPY distribution/bootc/files/usr/libexec/ix1-update /usr/libexec/ix1-update
COPY distribution/bootc/files/etc/polkit-1/rules.d/50-ix1-updates.rules \
     /etc/polkit-1/rules.d/50-ix1-updates.rules
RUN chmod 755 /usr/libexec/ix1-update

# ---- M8 QA fixes ------------------------------------------------------------
# ix1 ships its own lock screen; KDE's kscreenlocker daemon is only present
# as a KWin dependency and its greeter aborts in this image, so disable its
# automatic locking (idle/resume) — the ix1 lock surface is the only one.
COPY distribution/bootc/files/etc/xdg/kscreenlockerrc /etc/xdg/kscreenlockerrc
# The deployment root is an overlay (composefs) on bootc; remounting it per
# fstab fails and leaves every boot 'degraded'. The initrd already mounts it
# read-only, so the remount is a no-op — tolerate the failure.
COPY distribution/bootc/files/etc/systemd/system/systemd-remount-fs.service.d/bootc-root-overlay.conf \
     /etc/systemd/system/systemd-remount-fs.service.d/bootc-root-overlay.conf

# Release marker read by ix1-settings and used in update verification.
RUN echo "${IX1_RELEASE}" > /etc/ix1-release

# SELinux: relabel filesystem content added by this Containerfile.
RUN restorecon -R /etc /usr/share /usr/bin /usr/libexec /usr/lib/tmpfiles.d /usr/lib/systemd 2>/dev/null || true

# sshd is useful for automated boot validation on the dev image only.
RUN systemctl enable sshd.service || true
RUN systemctl enable sddm.service || true

LABEL org.opencontainers.image.title="ix1" \
      org.opencontainers.image.description="ix1 desktop operating system (Fedora bootc base)" \
      org.opencontainers.image.vendor="ix1" \
      org.opencontainers.image.licenses="MIT" \
      ix1.release="${IX1_RELEASE}"

RUN bootc container lint
